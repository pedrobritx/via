# VIA — variáveis de ambiente
#
# TODAS são OPCIONAIS. Sem nenhuma delas o app funciona por completo usando os
# provedores offline determinísticos. Isso é deliberado: qualquer pessoa deve
# conseguir clonar o repositório e reproduzir os cálculos sem pedir credencial
# a ninguém. É o que torna o método auditável.

# --- Roteamento -------------------------------------------------------------
# Sem chave: usa o estimador offline (haversine + fator de sinuosidade por
# modal). Com chave: usa o OpenRouteService, que considera a malha viária real.
# Obtenha em https://openrouteservice.org/dev/#/signup
VIA_ORS_API_KEY=

# URL base do OpenRouteService. Só altere se usar uma instância própria.
VIA_ORS_BASE_URL=https://api.openrouteservice.org

# --- Geocodificação ---------------------------------------------------------
# "offline" (padrão) usa as fixtures em src/domain/providers/offlineGeocode.ts.
# "nominatim" consulta o Nominatim/OpenStreetMap.
# Atenção: a política de uso do Nominatim exige um User-Agent identificável e
# limita a 1 req/s. Não use em produção sem instância própria.
VIA_GEOCODE_PROVIDER=offline

# User-Agent enviado ao Nominatim. Obrigatório se VIA_GEOCODE_PROVIDER=nominatim.
VIA_NOMINATIM_USER_AGENT=
